# Joins - Joins in sql is used to combine rows from 1 or more tables based on related col
# Types of joins
# 1. Inner join
# 2. Left join
# 3. Right join
# 4. Full-outer join
# 5. Self join

# 1. Inner join
# Returns only the matching rows from both tables
# Unmatched rows are excluded

# 2. Left join
# Returns all rows from the left table
# Returns matching rows from the rigth table 
# If there is no match the right side col conatin null

# 3. Right join
# Returns all rows from the right table 
# Returns matching rows from the left table
# If there is no match the left side col contain null

# 4. Full-outer join
# Returns all rows from both tables 
# Matching rows are combined
# Non matching rows from either table are also returned with null values for the missing side

# 5. Self join
# Joins a table with itself
# Useful for comparing rows with the same table 

use sample;
select * from superstore;
# create customers table and orders table
create table customers select distinct customer_name,order_id,segment,city,state,region from superstore;
create table orders select distinct order_id,product_name,segment,category,sub_category,quantity,profit,sales,state,city,region,order_date,ship_date from superstore;

#inner join
select c.customer_name,c.order_id,o.order_id,o.product_name,o.segment from customers as c inner join orders as o  on c.order_id=o.order_id;
# or
select c.customer_name,c.order_id,o.order_id,o.product_name from customers c inner join orders o  on c.order_id=o.order_id;
# customers - customer_name,city,order_id  orders - order_id,product_name,city
select c.customer_name,c.city,c.order_id,o.order_id,o.product_name,o.city from customers c inner join orders o on c.city=o.city;


#natural join 
select emp_name,dept_name from employee natural join department;
#not equi join
select e1.emp_name as employee1,e1.salary,e2.emp_name as employee2,e2.salary from employee e1 join employee e2 on e1.salary>e2.salary;
#exist->exist means returns true if the subquery returns atleast one row
#non exist->returns true if the subquery returns atleast no rows
select d.dept_id,d.dept_name from department d where exists(select * from employee e where d.dept_id=e.dept_id);
select d.dept_id,d.dept_name from department d where not exists(select * from employee e where d.dept_id=e.dept_id);





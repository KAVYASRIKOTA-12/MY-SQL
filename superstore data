select customer_name,left(customer_name,5) as left_name from superstore;
#right
#display last 6 characters in customer_name
select customer_name,right(customer_name,6) as right_name from superstore;
#substring
select customer_name,substring(customer_name,1,6) as sub from superstore;
select customer_name,substring(customer_name,5) as sub from superstore;
#mid
select customer_name,mid(customer_name,5,9) as mid from superstore;
#replace

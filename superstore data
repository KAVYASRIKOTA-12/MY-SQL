#trim
select customer_name,trim(customer_name) as tri from superstore;
#ltrim
select customer_name,ltrim(customer_name) as ltri from superstore;
#rtrim
select customer_name,rtrim(customer_name) as rtri from superstore;
#reverse
select product_name,reverse(product_name) as rev from superstore;
#locate

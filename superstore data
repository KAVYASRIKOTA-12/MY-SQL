use sample;
select * from superstore;
select category,country,segment from superstore;
select country from superstore;
#it will display multiple records
#distinct is used to remove the duplicate records from table;
select distinct country from superstore; 
select distinct country,category from superstore;
select distinct country,category,segment from superstore;
#order by is used to keep records in ascending or descending order
select distinct country from superstore order by country asc;
select distinct country,category from superstore order by category desc;
select distinct country,category,segment from superstore order by segment asc;
select distinct sales from superstore order by sales asc;
select distinct sales from superstore order by sales desc;
select distinct country,sales from superstore order by country,sales asc;
select distinct country,sales from superstore order by country,sales desc;
#to get all records from germany country
select * from superstore where country="germany";
select distinct country from superstore where country="germany";
select distinct country from superstore where country="germany" and country="france"; #ntg will display
select distinct country from superstore where country="germany" or country="france";
select distinct country from superstore where country="france" or country="spain";
select distinct country from superstore where country="france" or country="spain" or country="italy" or country="austria";
select distinct country from superstore where country in("france","spain","italy","austria");
select distinct country from superstore where country in("france","spain","italy","austria") order by country asc;
select distinct country from superstore where country in("france","spain","italy","austria") order by country desc;
#to get all records from country austria and category technology
select * from superstore where country="austria" and category="technology";
select distinct country,category from superstore where country="austria" and category="technology";
#to get all records from superstore expect germany country(!=,<>)
select * from superstore where country!="germany";
select * from superstore where country<>"germany";
select distinct country from superstore where country!="germany";
select distinct country from superstore where country<>"germany";
#to get all country's except italy,spain,nepal
select distinct country from superstore where country not in("italy","spain","nepal");
select distinct country from superstore where country<>"italy" and country<>"spain" and country<>"nepal";
#to get all records from sales where sales>=1000
select * from superstore where sales>=1000;
select distinct sales from superstore where sales>=1000;
select distinct sales from superstore where sales>=1000 order by sales asc;
select distinct sales from superstore where sales>=1000 order by sales desc;
#to get all records from sales where sales between 500 to 1000
select distinct sales from superstore where sales between 500 and 1000;
select distinct sales from superstore where sales>=500 and sales<=1000;
select distinct sales from superstore where sales between 500 and 1000 order by sales asc;
select distinct sales from superstore where sales between 500 and 1000 order by sales desc;

#aggreations fns min,max,sum,avg,count
select * from superstore;
select country,sales from superstore;
select min(sales) from superstore;
select max(sales) from superstore;
select sum(sales) from superstore;
select avg(sales) from superstore;
select count(sales) from superstore;
select sum(sales) as total_sale from superstore;
select avg(sales) as avg_sale from superstore;
select min(sales) as min_sale from superstore;
select max(sales) as max_sale from superstore;
select count(sales) as count_sale from superstore;
select country,sum(sales) from superstore group by country;
select country,segment,sum(sales) from superstore group by country,segment;
select country,sum(sales) from superstore where country = "germany";
select country,sum(sales) from superstore where country in ("germany","france") group by country;
select country,sum(sales) from superstore where country in ("germany","france") group by country order by sum(sales);
select country,region,sum(sales) from superstore where country in ("germany","france","spain","italy") and Region in("south","north") group by country,Region;

#get country wise total_sales and avg_sales and country should be france
select country,sum(sales) as total_sales,avg(sales) as avg_sales from superstore where country="france";
#get segment,country and region wise total_sales and avg_sales
select segment,country,region,sum(sales) as total_sales,avg(sales) as avg_sales from superstore group by segment,country,region;
select segment,country,region,sum(sales) as total_sales,avg(sales) as avg_sales from superstore group by 1,2,3;
#get segment,country wise avg_sales
select segment,country,avg(sales) as avg_sales from superstore group by 1,2;
#get segment,country wise avg_sales and avg_sales must be greater than 300
select segment,country,avg(sales) as avg_sales from superstore where avg_sales>300 group by 1,2;#error
select segment,country,avg(sales) as avg_sales from superstore group by segment,country having avg_sales>300;
#get country wise total_sales and country shold be either austria or france or spain or italy or nepal and total_sales must be greter than 2 lakhs
select country,sum(sales) as total_sales from superstore where country in("austria","france","spain","italy","nepal") group by country having total_sales>200000 order by country;



#get country wise total_profit and country should be either germany or belgium or france or netherlands and total_profit must be greater than 200
select country,sum(profit) as total_profit from superstore where country in("germany","belgium","france","netherlands") group by country having total_profit>200;
#total quantity must be greater than 2
select country,sum(quantity) as total_quantity from superstore where country in("germany","belgium","france","netherlands") group by country having total_quantity>2;
#total_sales must be greater than 700
select country,sum(sales) as total_sales from superstore where country in("germany","belgium","france","netherlands") group by country having total_sales>700;
#bitwise operators
#&,|,~,^,<<,>>
#to get the result of quantity of 3
select product_name,quantity,quantity & 3 as Bitwise_AND from superstore;
select product_name,quantity,quantity | 2 as Bitwise_OR from superstore;
select product_name,quantity,~quantity as Bitwise_NOT from superstore;
select product_name,quantity,quantity ^ 6 as Bitwise_XOR from superstore;
select product_name,quantity,quantity <<1  as Bitwise_LEFTSHIFT from superstore;
select product_name,quantity,quantity >>1 as Bitwise_RIGHTSHIFT from superstore;
#list of the quantity (odd quantity)
select product_name,quantity from superstore where quantity&1=1;
#list of the quantity (even quantity)
select product_name,quantity from superstore where quantity&1=0;

#numeric functions
#mod,round,pow,sqrt,log,tan,cos,sin,greatest,least,pi,ceil,floor
#mod->remainder
select product_name,sales,mod(sales,10) as remainder from superstore;
#pow
select product_name,quantity,pow(quantity,2) as result from superstore;
#sqrt
select product_name,sales,sqrt(sales) as sqrt from superstore;
#ceil
select product_name,sales,ceil(sales/2.0) as ceil from superstore;
select product_name,quantity,ceil(quantity/2.0) as ceil from superstore;
#floor
select product_name,profit,floor(profit/2.0) as floor from superstore;
select product_name,quantity,floor(quantity/2.0) as floor from superstore;
#round
select product_name,quantity,round(quantity/3,4) as rd from superstore;
select product_name,sales,round(sales/3,4) as rd from superstore;
#log
select product_name,quantity,log(quantity) as log from superstore;
#sin
select product_name,quantity,sin(quantity) as sin from superstore;
#cos
select product_name,quantity,cos(quantity) as cos from superstore;
#tan
select product_name,quantity,tan(quantity) as tan from superstore;
#cot
select product_name,quantity,cot(quantity) as cot from superstore;
#pi
select pi() as pi from superstore;
#greatest,least,abs,truncate
select sales,quantity,profit,greatest(sales,quantity,profit) as greatest_value from superstore;
select sales,quantity,profit,least(sales,quantity,profit) as least_value from superstore;
select profit,abs(profit) as actual_profit from superstore;
#truncate is used to remove roundup values
select sales,truncate(sales/3,3) as truncate_value from superstore;

#string functions
